# Dune Server — environment configuration
# Copy to .env and adjust. All variables optional unless noted.

# Port the server listens on (compose maps 3023:3030)
PORT=3030

# Comma-separated extra browser origins (LAN IP, reverse proxy, Tailwind hostname)
# Example: ALLOWED_ORIGINS=https://dune.home.example,http://192.168.1.50:3023
ALLOWED_ORIGINS=

# Secret used to HMAC API keys before storage. Min 16 chars.
# If unset, a random secret is generated and persisted at data/.api-secret (0600).
# Changing it invalidates all existing keys (clients must re-register).
API_KEY_SECRET=

# Per-file upload cap in MB for streaming saves (default 500)
MAX_UPLOAD_MB=500

# Max files tracked per game (default 5000)
MAX_FILES_PER_GAME=5000

# Log level for future structured logging (debug, info, warn, error)
LOG_LEVEL=info

# Third-party keys (also configurable via Settings UI / API)
# STEAMGRIDDB_API_KEY=
# OLLAMA_URL=http://ollama:11434
