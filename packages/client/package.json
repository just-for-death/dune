{
  "name": "@dune/client",
  "version": "0.2.0-beta.2",
  "author": {
    "name": "Yashwin",
    "email": "github.iag54@slmail.me"
  },
  "main": "dist-electron/main.js",
  "desktopName": "io.github.just-for-death.dune.desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "electron-builder",
    "build:all": "tsc && vite build && electron-builder",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dune/shared": "file:../shared",
    "@fontsource/inter": "^5.2.8",
    "adm-zip": "^0.6.1",
    "axios": "^1.14.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "io.github.just-for-death.dune",
    "productName": "Dune",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "syncDesktopName": true
    },
    "artifactName": "${productName}-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "just-for-death",
        "repo": "dune"
      }
    ],
    "executableName": "Dune"
  },
  "description": "Dune — game save sync desktop client (Electron)",
  "homepage": "https://github.com/just-for-death/dune#readme"
}
