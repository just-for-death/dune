{
  "name": "@dune/client",
  "version": "0.1.0-beta.1",
  "author": {
    "name": "Yashwin",
    "email": "github.iag54@slmail.me"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "electron-builder",
    "build:all": "tsc && vite build && electron-builder",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dune/shared": "file:../shared",
    "@fontsource/inter": "^5.2.8",
    "adm-zip": "^0.5.10",
    "axios": "^1.14.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.19.37",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "electron": "^44.8.0",
    "electron-builder": "^24.6.3",
    "typescript": "^5.0.2",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "allowScripts": {
    "electron@44.8.0": true
  },
  "build": {
    "appId": "io.github.just-for-death.dune",
    "productName": "Dune",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "artifactName": "${productName}-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "just-for-death",
        "repo": "dune"
      }
    ]
  },
  "description": "Dune — game save sync desktop client (Electron)",
  "homepage": "https://github.com/just-for-death/dune#readme"
}
