{
  "name": "@dune/providers",
  "version": "0.2.0-beta.2",
  "private": true,
  "description": "Outbound provider integrations for Dune (HLTB, artwork, trackers, manifests, update checks), shared by the server and Electron main. Injected transport, keys and cache; every provider is off until enabled.",
  "author": "Yashwin",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "zod": "^4.6.7"
  }
}
