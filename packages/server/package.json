{
  "name": "@dune/server",
  "version": "0.2.0-beta.1",
  "author": "Yashwin",
  "description": "Dune Server — Express + tRPC backend for game save sync",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "audit": "npm audit --omit=dev --audit-level=high",
    "tui": "tsx src/tui/index.tsx",
    "tui:dev": "tsx watch src/tui/index.tsx"
  },
  "dependencies": {
    "@dune/shared": "file:../shared",
    "@trpc/server": "^11.0.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ink": "^8.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.0",
    "supertest": "^7.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.5"
  }
}
